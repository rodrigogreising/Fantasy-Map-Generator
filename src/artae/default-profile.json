{
  "name": "Default",
  "levels": [1, 20],
  "levelBase": 2,
  "texts": { "node": "Node of {a}", "nodePair": "Node of {a} and {b}" },
  "grammar": {
    "pair": "{adjective} {noun}",
    "pure": ["Pure", "Pure"],
    "articles": {
      "m": { "el": "the", "de": "of the", "al": "to the" },
      "f": { "el": "the", "de": "of the", "al": "to the" }
    }
  },
  "elements": [
    { "name": "Fire", "family": "Matter", "color": "#e0482b", "adjective": ["Fiery", "Fiery"], "rule": "hot*0.8 + volcano*1.2 + desert*hot*0.4" },
    { "name": "Water", "family": "Matter", "color": "#2f7fd1", "adjective": ["Tidal", "Tidal"], "rule": "water*(0.6 + open*0.4) + wetland*0.7 + flux*0.6" },
    { "name": "Earth", "family": "Matter", "color": "#8a6a3e", "adjective": ["Stony", "Stony"], "rule": "if(water, 0, 0.4 + elev*(1 - elev)*1.6 + (1 - life)*0.2)" },
    { "name": "Air", "family": "Matter", "color": "#bfe3e8", "adjective": ["Windy", "Windy"], "rule": "elev*0.8 + (1 - water)*open*(1 - slope)*0.4 + coast*0.2" },
    { "name": "Ice", "family": "Matter", "color": "#9fd8f0", "adjective": ["Frozen", "Frozen"], "rule": "cold + glacier + polar*0.5" },
    { "name": "Light", "family": "Spirit", "color": "#ffe58a", "adjective": ["Bright", "Bright"], "rule": "sun*(1 - depth)" },
    { "name": "Shadow", "family": "Spirit", "color": "#2b2540", "adjective": ["Dark", "Dark"], "rule": "depth + polar" },
    { "name": "Life", "family": "Spirit", "color": "#6fd36a", "adjective": ["Living", "Living"], "rule": "life + wetland*0.4" }
  ],
  "tints": [
    { "name": "Conquest", "strategy": "conquest", "color": "#b3403a" },
    { "name": "Kinship", "strategy": "kinship", "color": "#3f9a5a" },
